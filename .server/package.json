{
  "name": "@nandenjin/portfolio-server",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "npm run clean && tsx build/index.ts",
    "build": "wrangler deploy --dry-run --outdir=dist/worker",
    "pretypecheck": "npm run prebuild",
    "typecheck": "tsc --noEmit",
    "dev": "npm run prebuild && wrangler dev",
    "deploy": "npm run prebuild && wrangler deploy",
    "clean": "rm -rf dist/ src/content.gen.ts"
  },
  "dependencies": {
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "25.9.9",
    "image-size": "2.0.4",
    "markdown-it": "14.3.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "wrangler": "4.135.0"
  }
}
